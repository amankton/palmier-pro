{
  "name": "palmier-pro-windows",
  "productName": "Palmier Pro Windows Alpha",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop port of Palmier Pro with a local FFmpeg media engine",
  "license": "GPL-3.0-only",
  "author": "Crewframe contributors; original Palmier Pro by Palmier, Inc.",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs src/theme.test.mjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "package:win": "npm run build && electron-builder --win dir --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "org.crewframe.palmier.windows.alpha",
    "productName": "Palmier Pro Windows Alpha",
    "asar": true,
    "compression": "store",
    "directories": { "output": "release" },
    "files": ["dist/**", "desktop/**", "core/**", "media/**", "src/AppTheme.js", "package.json", "README.md", "THIRD_PARTY_NOTICES.md"],
    "extraFiles": [{ "from": "../LICENSE", "to": "PALMIER-LICENSE.txt" }],
    "win": { "target": ["portable"], "signAndEditExecutable": false },
    "portable": { "artifactName": "Palmier-Pro-Windows-Alpha-${version}-${arch}.exe" }
  }
}
